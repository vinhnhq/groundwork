{
  "name": "groundwork",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:webpack": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "migrate": "bun run src/db/migrate.ts",
    "seed": "bun run src/db/seed.ts",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --project unit",
    "test:e2e": "playwright test",
    "summary": "bun run .claude/scripts/work-summary.ts",
    "mcp": "bun run src/mcp/server.ts"
  },
  "dependencies": {
    "@better-auth/kysely-adapter": "^1.6.25",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@neondatabase/serverless": "^1.1.0",
    "better-auth": "^1.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "es-toolkit": "^1.50.0",
    "gray-matter": "^4.0.3",
    "kysely": "^0.28",
    "kysely-neon": "^3.0.0",
    "lucide-react": "^1.26.0",
    "mermaid": "^11.16.0",
    "motion": "^12.43.0",
    "next": "16.2.11",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "purify-ts": "^2.1.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "ts-pattern": "^5.9.0",
    "type-fest": "^5.8.0",
    "vaul": "^1.1.2",
    "ws": "^8.21.1",
    "yaml": "^2.9.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.10",
    "babel-plugin-react-compiler": "^1.0.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
