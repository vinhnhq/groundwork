# Copy to .env.local for local dev: cp .env.example .env.local

# Content source (F2): comma-separated absolute paths to project repos to aggregate.
# Each repo should have a __project__/project.yml. Groundwork itself is a valid entry.
PROJECT_ROOTS=

# Database (F5). REQUIRED for sign-in — better-auth has no fallback store, so
# without it nobody can get into /ops at all.
#
#   Local:  docker compose up -d
#           bun run migrate && bun run seed
#           bun run migrate --test        # for the integration suite
#   Prod:   a Neon connection string. The driver is picked by host, so nothing
#           else changes between the two.
DATABASE_URL=postgres://groundwork:groundwork@localhost:55432/groundwork
DATABASE_TEST_URL=postgres://groundwork:groundwork@localhost:55432/groundwork_test

# Auth (F5 — better-auth, username + password, no social providers; ADR-0008).
# Unset outside production ⇒ the published dev secret applies; unset IN
# production ⇒ no session is issued or accepted at all.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# The password `bun run seed` gives the four role accounts. Unset ⇒ the
# development literal, which the seeder refuses to use when NODE_ENV=production.
ADMIN_PASSWORD=

# Later: triage agent (v3)
# ANTHROPIC_API_KEY=

# Later: cron/worker gating
# CRON_SECRET=

# Remote MCP door (G4). Unset outside production ⇒ the dev token applies;
# unset IN production ⇒ the endpoint is disabled (no default password).
MCP_TOKEN=

# Content source (S3). CONTENT_SOURCE=github switches off the filesystem adapter.
# Without GITHUB_TOKEN the GitHub path runs on a mock client (demo repo).
CONTENT_SOURCE=
GITHUB_REPOS=            # acme/checkout,acme/site#develop
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# Write-back transport (S1/S2/S4): memory (default, dry run) | filesystem | git-branch | github-pr
WRITE_BACK=
